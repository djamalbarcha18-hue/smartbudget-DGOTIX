<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of the app's data leaves the phone, neither to the
     Google account backup nor when moving to a new phone (device transfer).
     People back up from inside the app instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
